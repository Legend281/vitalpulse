rules_version = '2';

// VitalPulse — Firebase Storage Security Rules
// FIRST real Storage rules file in this project (see vitalpulse_app/docs/PHASE0_AUDIT.md
// §10 addendum, finding 4) — until now, Storage access had no rules file checked into
// this repo at all. Scope here is intentionally narrow: only the new kyc/{uid}/ path this
// Stream introduces (Auth & Onboarding Stream B3, donor UI/VitalPulse_Plan_Tracker.md).
// The pre-existing hospital_licenses/ upload path (vitalpulse_app/src/main.js, direct
// client uploadBytes() with no rules governing it at all) is a live precedent of exactly
// the pattern this file avoids for KYC docs — flagged, not silently hardened here, since
// widening scope to cover it wasn't part of this Stream.

service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() {
      return request.auth != null && request.auth.token.get('suspended', false) != true;
    }
    function isSystemAdmin() {
      return signedIn() && request.auth.token.get('role', null) == 'system_admin';
    }
    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // ---------- KYC identity documents ----------
    // SPARK PLAN MIGRATION (vitalpulse_app/docs/SPARK_PLAN_MIGRATION.md §7, Security Lead
    // decision 2026-08-05): previously written ONLY by submitKYC/submitLivenessSelfie
    // (functions/src/kyc.ts) via the Admin SDK — no client ever wrote here directly (C3.6).
    // Now the owning donor uploads directly. DELIBERATE, DOCUMENTED REGRESSION (plan §4,
    // risks R2/R3): the old Cloud Function decoded and measured the actual file bytes
    // server-side and hard-locked liveness selfies to image/jpeg specifically; rules can
    // only check declared size/content-type metadata, not inspect real file contents, and
    // this single rule now covers both identity docs (jpeg/png/pdf) and liveness selfies
    // (should be jpeg-only) since they share one path pattern. Reads stay owner-or-admin.
    match /kyc/{uid}/{fileName} {
      allow read: if isOwner(uid) || isSystemAdmin();
      allow write: if isOwner(uid)
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/jpeg|image/png|application/pdf');
    }

    // ---------- Deny by default ----------
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
