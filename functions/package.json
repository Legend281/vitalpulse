{
  "name": "vitalpulse-functions",
  "version": "1.0.0",
  "private": true,
  "description": "VitalPulse server-side authorization and privileged-mutation Cloud Functions.",
  "engines": {
    "node": "20"
  },
  "main": "lib/index.js",
  "type": "commonjs",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions,auth,firestore",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "firebase-admin": "^12.7.0",
    "firebase-functions": "^6.3.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^20.17.9",
    "@vitest/coverage-v8": "^4.1.10",
    "firebase-functions-test": "^3.4.0",
    "typescript": "^5.7.2",
    "vitest": "^4.1.10"
  }
}
