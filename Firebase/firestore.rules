rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: check if the requester is authenticated
    function isAuth() {
      return request.auth != null;
    }

    // Helper: get user role from the users collection
    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return isAuth() && getUserRole() == 'admin';
    }

    function isHospital() {
      return isAuth() && getUserRole() == 'hospital';
    }

    // Users collection: each user can read/write their own doc; admins can read/write all
    match /users/{userId} {
      allow read: if isAuth() && (request.auth.uid == userId || isAdmin());
      allow create: if isAuth() && request.auth.uid == userId;
      allow update: if isAuth() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }

    // Blood requests: authenticated users can create; hospitals/admins can read/update
    match /requests/{requestId} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update: if isAuth() && (isHospital() || isAdmin());
      allow delete: if isAdmin();
    }

    // Hospital inventory: hospitals can read/write their own; admins can read/write all
    match /inventory/{hospitalName} {
      allow read: if isAuth();
      allow write: if isAuth() && (isHospital() || isAdmin());
    }

    // Global inventory: admins only
    match /global_inventory/{type} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    // Activity logs: read by authenticated users, written by server
    match /activity_logs/{logId} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Donation requests
    match /donation_requests/{donationId} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update: if isAuth() && (isAdmin() || isHospital());
      allow delete: if isAdmin();
    }

    // Campaigns
    match /campaigns/{campaignId} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update: if isAuth() && (isAdmin() || isHospital());
      allow delete: if isAdmin();
    }

    // Hospital notifications
    match /hospital_notifications/{notificationId} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update: if isAuth();
      allow delete: if isAdmin();
    }

    // Notification log
    match /notification_log/{logId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // System settings (admins only)
    match /system_settings/{settingId} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    // Incoming donors (hospital-assigned donor records)
    match /incoming_donors/{donorId} {
      allow read: if isAuth();
      allow write: if isAuth() && (isHospital() || isAdmin());
    }

    // Inventory movements
    match /inventory_movements/{movementId} {
      allow read: if isAuth();
      allow create: if isAuth() && (isHospital() || isAdmin());
      allow delete: if isAdmin();
    }

    // Donor engagement records
    match /donor_engagement/{engagementId} {
      allow read: if isAuth();
      allow write: if isAuth();
    }

    // Public requests (emergency blood requests from hospitals/unregistered sources)
    match /public_requests/{requestId} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update: if isAuth() && (isHospital() || isAdmin());
      allow delete: if isAdmin();
    }

    // Admin notifications
    match /admin_notifications/{notificationId} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update: if isAuth();
      allow delete: if isAdmin();
    }

    // Donor notifications
    match /donor_notifications/{notificationId} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update: if isAuth();
      allow delete: if isAdmin();
    }

    // Immutable audit trail — read by authenticated, written by system
    match /audit_logs/{logId} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update: if false;
      allow delete: if false;
    }

    // Blood issuance log — read by auth, write by hospitals/admins
    match /issuance_log/{logId} {
      allow read: if isAuth();
      allow create: if isAuth() && (isHospital() || isAdmin());
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Phone trust records — tracking phone reputation for public request verification
    match /phone_trust/{phoneHash} {
      allow read: if isAuth() && (isHospital() || isAdmin());
      allow write: if isAuth() && (isHospital() || isAdmin());
    }

    // Shadow hospitals — unregistered hospitals tracked via public requests
    match /shadow_hospitals/{shadowId} {
      allow read: if isAuth();
      allow write: if isAuth() && (isHospital() || isAdmin());
    }

    // ====== PHASE 3: Hemovigilance Reports ======
    match /hemovigilance_reports/{reportId} {
      allow read: if isAuth();
      allow create: if isAuth() && (isHospital() || isAdmin());
      allow update: if isAuth() && (isHospital() || isAdmin());
      allow delete: if isAdmin();
    }

    // ====== PHASE 3: Demand Forecasts ======
    match /demand_forecasts/{forecastId} {
      allow read: if isAuth();
      allow create: if isAuth() && (isHospital() || isAdmin());
      allow update: if isAuth() && (isHospital() || isAdmin());
      allow delete: if isAdmin();
    }

    // ====== PHASE 3: Myth-Busting Articles ======
    match /myth_articles/{articleId} {
      allow read: if isAuth();
      allow create: if isAuth() && (isHospital() || isAdmin());
      allow update: if isAuth() && (isHospital() || isAdmin());
      allow delete: if isAdmin();
    }

    // ====== PHASE 3: Care Reminders ======
    match /care_reminders/{reminderId} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update: if isAuth();
      allow delete: if isAuth();
    }

    // ====== PHASE 3: Life Saver Certificates ======
    match /life_saver_certificates/{certId} {
      allow read: if isAuth();
      allow create: if isAuth() && (isHospital() || isAdmin());
      allow update: if isAuth() && (isHospital() || isAdmin());
      allow delete: if isAdmin();
    }

    // Default: deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
