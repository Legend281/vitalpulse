rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: check if the requester is authenticated
    function isAuth() {
      // Suspension guard (2026-07-31): a suspended user's Firebase ID token stays
      // cryptographically valid for up to ~1h after admin.revokeRefreshTokens-style
      // suspension, and Firestore rules can't see revocation status. Cross-checking
      // the users doc's isSuspended field closes that gap immediately: suspension
      // takes effect on the next rule evaluation. Costs 1 extra read per rule
      // evaluation (documented tradeoff; revisit when suspension moves to a
      // Cloud-Function verifyIdToken path).
      return request.auth != null
        && !get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isSuspended;
    }

    // Helper: get user role from the users collection
    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return isAuth() && getUserRole() == 'admin';
    }

    function isHospital() {
      return isAuth() && getUserRole() == 'hospital';
    }

    // Users collection: each user can read/write their own doc; admins can read/write all.
    // Hospital accounts are also readable by any authenticated user — they're an institutional
    // directory (name/city/etc.), not a personal profile, and donors legitimately need to
    // browse it (donation centers list, partner network, choosing where to donate). Donor and
    // admin profiles stay private to their own owner + admin.
    match /users/{userId} {
      allow read: if isAuth() && (request.auth.uid == userId || isAdmin() || resource.data.role == 'hospital');
      allow create: if isAuth() && request.auth.uid == userId;
      allow update: if isAuth() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }

    // Blood requests: authenticated users can create; hospitals/admins can read/update
    match /requests/{requestId} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update: if isAuth() && (isHospital() || isAdmin());
      allow delete: if isAdmin();
    }

    // Hospital inventory: hospitals can read/write their own; admins can read/write all
    match /inventory/{hospitalName} {
      allow read: if isAuth();
      allow write: if isAuth() && (isHospital() || isAdmin());
    }

    // Global inventory: admins only
    match /global_inventory/{type} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    // Activity logs: admin-only reads (IDOR fix 2026-07-31 — previously readable by any
    // authenticated user); creation stays open because every client writes its own
    // activity entries.
    match /activity_logs/{logId} {
      allow read: if isAuth() && isAdmin();
      allow create: if isAuth();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Donation requests (donor-scheduled donations)
    // IDOR fix (2026-07-31): donors may only read their OWN records — previously any
    // authenticated user could list the whole collection (bloodType, preferredLocation,
    // notes of every donor). Hospitals/admins may read all (booking management).
    match /donation_requests/{donationId} {
      allow read: if isAuth() && (isHospital() || isAdmin() || resource.data.donorId == request.auth.uid);
      allow create: if isAuth();
      allow update: if isAuth() && (isAdmin() || isHospital());
      allow delete: if isAdmin();
    }

    // Campaigns
    match /campaigns/{campaignId} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update: if isAuth() && (isAdmin() || isHospital());
      allow delete: if isAdmin();
    }

    // Hospital notifications — owner-scoped reads (IDOR fix 2026-07-31):
    // a hospital may read only notifications addressed to its own uid.
    match /hospital_notifications/{notificationId} {
      allow read: if isAuth() && (isAdmin() || resource.data.hospitalId == request.auth.uid);
      allow create: if isAuth();
      allow update: if isAuth() && (isAdmin() || resource.data.hospitalId == request.auth.uid);
      allow delete: if isAdmin();
    }

    // Notification log
    match /notification_log/{logId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // System settings (admins only)
    match /system_settings/{settingId} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    // Incoming donors (hospital-assigned donor records)
    match /incoming_donors/{donorId} {
      allow read: if isAuth();
      allow write: if isAuth() && (isHospital() || isAdmin());
    }

    // Inventory movements
    match /inventory_movements/{movementId} {
      allow read: if isAuth();
      allow create: if isAuth() && (isHospital() || isAdmin());
      allow delete: if isAdmin();
    }

    // Donor engagement records
    match /donor_engagement/{engagementId} {
      allow read: if isAuth();
      allow write: if isAuth();
    }

    // Public requests (emergency blood requests from hospitals/unregistered sources)
    match /public_requests/{requestId} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update: if isAuth() && (isHospital() || isAdmin());
      allow delete: if isAdmin();
    }

    // Admin notifications — admin-only reads (IDOR fix 2026-07-31); creation stays open
    // because hospital signups create them client-side to alert admins.
    match /admin_notifications/{notificationId} {
      allow read: if isAuth() && isAdmin();
      allow create: if isAuth();
      allow update: if isAuth() && isAdmin();
      allow delete: if isAdmin();
    }

    // Donor notifications — owner-scoped reads (IDOR fix 2026-07-31): a donor may read
    // only notifications addressed to their own uid. Creation stays open (client-driven
    // matching/lab flows notify donors); writes restricted to the owner.
    match /donor_notifications/{notificationId} {
      allow read: if isAuth() && resource.data.donorId == request.auth.uid;
      allow create: if isAuth();
      allow update: if isAuth() && resource.data.donorId == request.auth.uid;
      allow delete: if isAdmin();
    }

    // Immutable audit trail — read by authenticated, written by system
    match /audit_logs/{logId} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update: if false;
      allow delete: if false;
    }

    // Blood issuance log — read by auth, write by hospitals/admins
    match /issuance_log/{logId} {
      allow read: if isAuth();
      allow create: if isAuth() && (isHospital() || isAdmin());
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Phone trust records — tracking phone reputation for public request verification
    match /phone_trust/{phoneHash} {
      allow read: if isAuth() && (isHospital() || isAdmin());
      allow write: if isAuth() && (isHospital() || isAdmin());
    }

    // Shadow hospitals — unregistered hospitals tracked via public requests
    match /shadow_hospitals/{shadowId} {
      allow read: if isAuth();
      allow write: if isAuth() && (isHospital() || isAdmin());
    }

    // ====== PHASE 3: Hemovigilance Reports ======
    match /hemovigilance_reports/{reportId} {
      allow read: if isAuth();
      allow create: if isAuth() && (isHospital() || isAdmin());
      allow update: if isAuth() && (isHospital() || isAdmin());
      allow delete: if isAdmin();
    }

    // ====== Donor Reaction Log ======
    // Distinct from hemovigilance — this is the DONOR feeling unwell after giving blood.
    match /donor_reactions/{reactionId} {
      allow read: if isAuth();
      allow create: if isAuth() && (isHospital() || isAdmin());
      allow update: if isAuth() && (isHospital() || isAdmin());
      allow delete: if isAdmin();
    }

    // ====== PHASE 3: Demand Forecasts ======
    match /demand_forecasts/{forecastId} {
      allow read: if isAuth();
      allow create: if isAuth() && (isHospital() || isAdmin());
      allow update: if isAuth() && (isHospital() || isAdmin());
      allow delete: if isAdmin();
    }

    // ====== PHASE 3: Myth-Busting Articles ======
    match /myth_articles/{articleId} {
      allow read: if isAuth();
      allow create: if isAuth() && (isHospital() || isAdmin());
      allow update: if isAuth() && (isHospital() || isAdmin());
      allow delete: if isAdmin();
    }

    // ====== PHASE 3: Care Reminders ======
    match /care_reminders/{reminderId} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update: if isAuth();
      allow delete: if isAuth();
    }

    // ====== PHASE 3: Life Saver Certificates ======
    match /life_saver_certificates/{certId} {
      allow read: if isAuth();
      allow create: if isAuth() && (isHospital() || isAdmin());
      allow update: if isAuth() && (isHospital() || isAdmin());
      allow delete: if isAdmin();
    }

    // ====== PHASE 2: Inter-Hospital Blood Transfers ======
    // Peer-to-peer between hospitals — no admin approval step by design.
    match /blood_transfers/{transferId} {
      allow read: if isAuth();
      allow create: if isAuth() && (isHospital() || isAdmin());
      allow update: if isAuth() && (isHospital() || isAdmin());
      allow delete: if isAdmin();
    }

    // ====== PHASE 2: Chronic / Recurring Patient Registry ======
    // Hospital-scoped — each hospital manages only its own patients.
    match /chronic_patients/{patientId} {
      allow read: if isAuth();
      allow create: if isAuth() && (isHospital() || isAdmin());
      allow update: if isAuth() && (isHospital() || isAdmin());
      allow delete: if isAuth() && (isHospital() || isAdmin());
    }

    // Default: deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
